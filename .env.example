PORT=8080
HOST=127.0.0.1
FRONTEND_ORIGIN=http://localhost:5173
DATA_DIR=./data
DISCOVERY_TIMEOUT_MS=150000
BROWSER_EXECUTABLE_PATH=
# Set to 1 temporarily to log sanitized missing-sticker diagnostics.
DISCOVERY_DEBUG=0

# Run npm run setup:admin after neon deploy to import the root Neon URLs
# and generate signing/encryption secrets in your ignored backend/.env.
WHATSAPP_ENABLED=0
DATABASE_URL=
DATABASE_URL_UNPOOLED=
ADMIN_JWT_SECRET=
WHATSAPP_ENCRYPTION_KEY=
# Seed once with npm run db:setup. No public registration route exists.
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD_HASH=
# Integration checks require a separate temporary Neon branch, never production.
NEON_TEST_DATABASE_URL=
